{
  "cli": {
    "version": "27.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "credentialsSource": "local",
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "24.22.1"
    },
    "production": {
      "distribution": "internal",
      "channel": "production",
      "environment": "production",
      "credentialsSource": "local",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "24.22.1"
    }
  }
}
