{
  "expo": {
    "name": "TrustBridge",
    "slug": "trustbridge",
    "scheme": "trustbridge",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101112",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/branding/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo for your TrustBridge account.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your saved TrustBridge account on this device."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "TrustBridge",
      "favicon": "./assets/branding/favicon.png"
    },
    "android": {
      "package": "za.co.devpeeps.trustbridge",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "allowBackup": false
    },
    "runtimeVersion": "1.0.1",
    "owner": "musambokazi",
    "extra": {
      "eas": {
        "projectId": "c6dde76a-9bb6-45ed-89f8-94e37776ec11"
      }
    },
    "icon": "./assets/branding/icon.png"
  }
}
